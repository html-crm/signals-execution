# Railway Backend Environment Variables
# Copy these to Railway project variables

# Server
NODE_ENV=production
PORT=3001

# Database (Railway provides this automatically with Postgres plugin)
DATABASE_URL=postgresql://...

# Frontend URL (your Vercel domain)
FRONTEND_URL=https://your-app.vercel.app

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-super-secure-jwt-secret-64-chars-minimum
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-64-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (32 chars exactly)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Exchange API Keys (for market data)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
MEXC_API_KEY=
MEXC_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BINGX_API_KEY=
BINGX_API_SECRET=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Redis (optional - Railway provides)
REDIS_URL=