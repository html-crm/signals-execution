generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ExchangeName {
  BINANCE
  BYBIT
  OKX
  MEXC
  BITGET
  BINGX
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LIMIT
  STOP_MARKET
}

enum OrderStatus {
  OPEN
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  REJECTED
  PENDING
}

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSING
  CLOSED
}

enum TradeMode {
  PAPER
  LIVE
}

enum BotStatus {
  ACTIVE
  INACTIVE
  ERROR
  STOPPED
}

enum SignalDirection {
  BUY
  SELL
  LONG
  SHORT
}

enum SignalStrength {
  WEAK
  NEUTRAL
  STRONG
  VERY_STRONG
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  exchangeAccounts ExchangeAccount[]
  bots            Bot[]
  trades          Trade[]
  orders          Order[]
  positions       Position[]
  apiKeys         ApiKey[]
  settings        UserSettings?
}

model ApiKey {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  exchange          ExchangeName
  apiKeyEncrypted   String
  apiSecretEncrypted String
  passphraseEncrypted String?
  permissions       String       @default("read,trade")
  isActive          Boolean      @default(true)
  lastUsedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  exchangeAccounts ExchangeAccount[]
}

model ExchangeAccount {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange        ExchangeName
  accountId       String
  name            String
  isDefault       Boolean        @default(false)
  isActive        Boolean        @default(true)
  apiKeyId        String
  apiKey          ApiKey         @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  balances        AccountBalance[]
  positions       Position[]
  orders          Order[]
  trades          Trade[]
  bots            Bot[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([userId, exchange, accountId])
  @@index([userId])
  @@index([exchange])
}

model AccountBalance {
  id                String            @id @default(cuid())
  exchangeAccountId String
  exchangeAccount   ExchangeAccount   @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  asset             String
  free              Decimal           @db.Decimal(30, 10)
  locked            Decimal           @db.Decimal(30, 10)
  total             Decimal           @db.Decimal(30, 10)
  usdValue          Decimal           @db.Decimal(30, 10)
  updatedAt         DateTime          @updatedAt

  @@unique([exchangeAccountId, asset])
  @@index([exchangeAccountId])
}

model Bot {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeAccountId String
  exchangeAccount   ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  name              String
  status            BotStatus  @default(INACTIVE)
  exchange          ExchangeName
  symbol            String
  timeframe         String
  strategy          String
  riskPerTrade      Float
  maxPositionSize   Float
  maxDailyLoss      Float
  maxOpenPositions  Int
  stopLossATR       Float
  takeProfitATR     Float
  mode              TradeMode  @default(PAPER)
  leverage          Int        @default(1)
  config            Json
  performance       Json
  isActive          Boolean    @default(true)
  lastSignalAt      DateTime?
  lastTradeAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  trades          Trade[]
  orders          Order[]
  positions       Position[]
  signals         Signal[]

  @@index([userId])
  @@index([exchangeAccountId])
  @@index([status])
  @@index([symbol])
}

model Trade {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId             String?
  bot               Bot?         @relation(fields: [botId], references: [id], onDelete: SetNull)
  exchangeAccountId String
  exchangeAccount   ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  positionId        String?
  position          Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  
  symbol            String
  exchange          String
  side              OrderSide
  type              OrderType
  price             Decimal      @db.Decimal(30, 10)
  quantity          Decimal      @db.Decimal(30, 10)
  fee               Decimal      @db.Decimal(30, 10)
  feeAsset          String
  pnl               Decimal?     @db.Decimal(30, 10)
  pnlPercent        Decimal?     @db.Decimal(10, 4)
  status            OrderStatus  @default(FILLED)
  tradeMode         TradeMode    @default(PAPER)
  strategy          String?
  signalConfidence  Int?
  timeframe         String?
  stopLoss          Decimal?     @db.Decimal(30, 10)
  takeProfit        Decimal?     @db.Decimal(30, 10)
  executedAt        DateTime     @default(now())
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([botId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([executedAt])
  @@index([tradeMode])
}

model Order {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId               String?
  bot                 Bot?         @relation(fields: [botId], references: [id], onDelete: SetNull)
  exchangeAccountId   String
  exchangeAccount     ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  exchangeOrderId     String?
  clientOrderId       String?
  
  symbol              String
  exchange            String
  side                OrderSide
  type                OrderType
  price               Decimal      @db.Decimal(30, 10)
  stopPrice           Decimal?     @db.Decimal(30, 10)
  quantity            Decimal      @db.Decimal(30, 10)
  filledQuantity      Decimal      @db.Decimal(30, 10) @default(0)
  remainingQuantity   Decimal      @db.Decimal(30, 10)
  value               Decimal      @db.Decimal(30, 10)
  fee                 Decimal      @db.Decimal(30, 10) @default(0)
  feeAsset            String?
  status              OrderStatus  @default(OPEN)
  tradeMode           TradeMode    @default(PAPER)
  reduceOnly          Boolean      @default(false)
  postOnly            Boolean      @default(false)
  timeInForce         String?      @default("GTC")
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  filledAt            DateTime?
  cancelledAt         DateTime?

  @@index([userId])
  @@index([botId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([status])
  @@index([exchangeOrderId])
  @@index([clientOrderId])
}

model Position {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId               String?
  bot                 Bot?           @relation(fields: [botId], references: [id], onDelete: SetNull)
  exchangeAccountId   String
  exchangeAccount     ExchangeAccount @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  
  symbol              String
  exchange            String
  side                PositionSide
  entryPrice          Decimal        @db.Decimal(30, 10)
  markPrice           Decimal        @db.Decimal(30, 10)
  size                Decimal        @db.Decimal(30, 10)
  value               Decimal        @db.Decimal(30, 10)
  leverage            Int            @default(1)
  margin              Decimal        @db.Decimal(30, 10)
  unrealizedPnl       Decimal        @db.Decimal(30, 10) @default(0)
  realizedPnl         Decimal        @db.Decimal(30, 10) @default(0)
  pnlPercent          Decimal        @db.Decimal(10, 4) @default(0)
  stopLoss            Decimal?       @db.Decimal(30, 10)
  takeProfit          Decimal?       @db.Decimal(30, 10)
  trailingStop        Decimal?       @db.Decimal(30, 10)
  liquidationPrice    Decimal?       @db.Decimal(30, 10)
  status              PositionStatus @default(OPEN)
  tradeMode           TradeMode      @default(PAPER)
  
  openedAt            DateTime       @default(now())
  closedAt            DateTime?
  updatedAt           DateTime       @updatedAt

  @@index([userId])
  @@index([botId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([status])
}

model Signal {
  id                  String           @id @default(cuid())
  botId               String?
  bot                 Bot?             @relation(fields: [botId], references: [id], onDelete: SetNull)
  exchangeAccountId   String
  exchangeAccount     ExchangeAccount  @relation(fields: [exchangeAccountId], references: [id], onDelete: Cascade)
  
  symbol              String
  exchange            String
  timeframe           String
  direction           SignalDirection
  strength            SignalStrength
  confidence          Int
  
  entryPrice          Decimal          @db.Decimal(30, 10)
  stopLoss            Decimal          @db.Decimal(30, 10)
  takeProfit          Decimal          @db.Decimal(30, 10)
  takeProfit2         Decimal?         @db.Decimal(30, 10)
  riskReward          Decimal          @db.Decimal(10, 4)
  invalidationLevel   Decimal?         @db.Decimal(30, 10)
  
  indicators          Json
  reasoning           String[]
  warnings            String[]
  
  executed            Boolean          @default(false)
  executedAt          DateTime?
  tradeId             String?
  
  createdAt           DateTime         @default(now())

  @@index([botId])
  @@index([exchangeAccountId])
  @@index([symbol])
  @@index([direction])
  @@index([createdAt])
  @@index([executed])
}

model OrderBookSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  exchange  String
  bids      Json
  asks      Json
  timestamp DateTime   @default(now())
  
  @@index([symbol, exchange])
  @@index([timestamp])
}

model MarketData {
  id            String   @id @default(cuid())
  exchange      String
  symbol        String
  timeframe     String
  open          Decimal  @db.Decimal(30, 10)
  high          Decimal  @db.Decimal(30, 10)
  low           Decimal  @db.Decimal(30, 10)
  close         Decimal  @db.Decimal(30, 10)
  volume        Decimal  @db.Decimal(30, 10)
  timestamp     DateTime
  createdAt     DateTime @default(now())
  
  @@unique([exchange, symbol, timeframe, timestamp])
  @@index([exchange, symbol, timeframe])
  @@index([timestamp])
}

model FundingRateHistory {
  id        String       @id @default(cuid())
  exchange  String
  symbol    String
  rate      Decimal      @db.Decimal(20, 10)
  timestamp DateTime
  createdAt DateTime     @default(now())
  
  @@unique([exchange, symbol, timestamp])
  @@index([exchange, symbol])
  @@index([timestamp])
}

model OpenInterestHistory {
  id        String       @id @default(cuid())
  exchange  String
  symbol    String
  value     Decimal      @db.Decimal(30, 10)
  timestamp DateTime
  createdAt DateTime     @default(now())
  
  @@unique([exchange, symbol, timestamp])
  @@index([exchange, symbol])
  @@index([timestamp])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(true)
  errorMessage String?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model BotPerformance {
  id            String   @id @default(cuid())
  botId         String   @unique
  bot           Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  totalTrades   Int      @default(0)
  winningTrades Int      @default(0)
  losingTrades  Int      @default(0)
  winRate       Float    @default(0)
  totalPnl      Float    @default(0)
  totalPnlPct   Float    @default(0)
  avgWin        Float    @default(0)
  avgLoss       Float    @default(0)
  profitFactor  Float    @default(0)
  sharpeRatio   Float    @default(0)
  maxDrawdown   Float    @default(0)
  maxDrawdownPct Float   @default(0)
  avgHoldTime   Int      @default(0)
  bestTrade     Float    @default(0)
  worstTrade    Float    @default(0)
  updatedAt     DateTime @updatedAt
}

model MarketScannerCache {
  id        String   @id @default(cuid())
  timeframe   String
  results   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@unique([timeframe])
  @@index([expiresAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}