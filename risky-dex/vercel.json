{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {"source": "/api/(.*)", "destination": "https://risky-dex-backend.fly.dev/api/$1"},
    {"source": "/ws/(.*)", "destination": "wss://risky-dex-backend.fly.dev/ws/$1"}
  ]
}